# ── Required ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

POSTGRES_PASSWORD=change_me

# ── LLM backend (ollama | groq | vllm | claude | bedrock) ────────────────────
LLM_BACKEND=ollama
JQL_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M

# ── Groq (only needed when LLM_BACKEND=groq) ─────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── vLLM (only needed when LLM_BACKEND=vllm) ─────────────────────────────────
VLLM_URL=
# VLLM_TIMEOUT=240
# VLLM_MAX_TOKENS=500
# VLLM_API_KEY=

# ── Claude direct (only needed when LLM_BACKEND=claude) ──────────────────────
CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# ── AWS Bedrock (only needed when LLM_BACKEND=bedrock) ───────────────────────
AWS_BEARER_TOKEN_BEDROCK=
CUSTOM_ENDPOINT=
# BEDROCK_REGION=custom
# BEDROCK_MODEL=claude-sonnet-4

# ── Jira (optional) ───────────────────────────────────────────────────────────
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
MAX_JIRA_RESULTS=1000
STANDARD_FIELD_IDS=key,summary,assignee,priority,issuetype,created,resolutiondate
